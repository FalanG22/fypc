    window.saveUser = async (id) => {
      const data = {
        username: document.getElementById('uf-user').value,
        nombre: document.getElementById('uf-name').value,
        password: document.getElementById('uf-pass').value,
        role: document.getElementById('uf-role').value,
      };
      if (id) data.activo = document.getElementById('uf-activo')?.checked;
      try {
        if (id) await API.put('/api/auth/users/'+id, data);
        else await API.post('/api/auth/users', data);
        bootstrap.Modal.getInstance('#detalleModal').hide();
        loadModule('usuarios');
      } catch(e) { alert(e.error||'Error'); }
    };

