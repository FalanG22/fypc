<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>ERP FYPC Viewer</title>
  <link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'><rect width='32' height='32' rx='6' fill='%233498db'/><text x='16' y='23' text-anchor='middle' font-size='20' font-weight='bold' fill='white' font-family='Arial'>F</text></svg>">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
  <style>
    * { box-sizing: border-box; }
    body { font-size: .8rem; background: #f0f2f5; font-family: 'Segoe UI',Arial,sans-serif; }
    .sidebar { position: fixed; top: 0; bottom: 0; left: 0; z-index: 100; padding: 0; width: 230px; background: linear-gradient(180deg,#1a2332 0,#0f1520 100%); overflow-y: auto; display:flex; flex-direction:column; }
    .sidebar::-webkit-scrollbar { width: 4px; }
    .sidebar::-webkit-scrollbar-thumb { background: #2c3e50; border-radius: 4px; }
    .sidebar .brand { padding: 14px 16px; border-bottom: 1px solid #1f2d3d; }
    .sidebar .brand h6 { color: #ecf0f1; font-size: .82rem; margin: 0; letter-spacing: .3px; }
    .sidebar .brand small { color: #5d7a9a; font-size: .65rem; }
    .sidebar .mod-group { padding: 10px 16px 2px; color: #4a6a8a; font-size: .6rem; text-transform: uppercase; letter-spacing: 1px; font-weight: 600; }
    .sidebar .nav-link { color: #8899aa; padding: 6px 16px; font-size: .78rem; border-left: 3px solid transparent; transition: all .15s; }
    .sidebar .nav-link:hover { color: #fff; background: rgba(255,255,255,.05); border-left-color: #3498db; }
    .sidebar .nav-link.active { color: #fff; background: rgba(52,152,219,.15); border-left-color: #3498db; }
    .sidebar .nav-link i { margin-right: 8px; width: 16px; text-align: center; font-size: .75rem; }
    main { margin-left: 230px; padding: 20px 24px; min-height: 100vh; }
    .card { border: none; border-radius: 10px; box-shadow: 0 1px 4px rgba(0,0,0,.06); margin-bottom: 16px; }
    .card-header { background: #fff; border-bottom: 1px solid #eef1f5; font-weight: 600; padding: 10px 18px; font-size: .82rem; border-radius: 10px 10px 0 0 !important; }
    .stat-card { padding: 18px; text-align: center; border-radius: 10px; transition: transform .15s; }
    .stat-card:hover { transform: translateY(-2px); }
    .stat-card .number { font-size: 1.6rem; font-weight: 700; color: #1a2332; }
    .stat-card .label { color: #7f8c8d; font-size: .7rem; text-transform: uppercase; letter-spacing: .5px; }
    .stat-card i { font-size: 1.4rem; color: #3498db; margin-bottom: 6px; }
    .table th { font-weight: 600; color: #555; font-size: .7rem; text-transform: uppercase; white-space: nowrap; background: #f8f9fa; }
    .table td { vertical-align: middle; font-size: .76rem; max-width: 250px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .table-wrap { max-height: 65vh; overflow-y: auto; border-radius: 0 0 10px 10px; }
    .table-wrap thead { position: sticky; top: 0; z-index: 2; }
    .table-wrap thead th { position: sticky; top: 0; }
    .detail-panel { background: #f8f9fa; border-radius: 8px; padding: 14px; }
    .detail-panel dt { font-size: .68rem; color: #7f8c8d; text-transform: uppercase; letter-spacing: .3px; margin-top: 6px; }
    .detail-panel dd { margin-bottom: 2px; font-size: .8rem; }
    .search-box { max-width: 380px; }
    .nav-tabs .nav-link { font-size: .78rem; padding: 6px 14px; }
    .nav-tabs .nav-link.active { font-weight: 600; }
    .badge { font-size: .65rem; font-weight: 500; }
    .loading { text-align: center; padding: 60px 20px; }
    .loading .spinner-border { width: 2.5rem; height: 2.5rem; }
    .row-click { cursor: pointer; }
    .row-click:hover { background: #eef5ff !important; }
    .schema-table-row { cursor: pointer; }
    .schema-table-row:hover { background: #f0f7ff; }
    .module-header { margin-bottom: 16px; }
    .module-header h4 { font-size: 1.1rem; font-weight: 600; }
    .module-header h4 i { color: #3498db; margin-right: 8px; }
    .btn-sm { font-size: .75rem; }
    .form-control-sm, .form-select-sm { font-size: .78rem; }
    .login-screen { display:flex; align-items:center; justify-content:center; min-height:100vh; background:linear-gradient(135deg,#1a2332 0,#0f1520 100%); }
    .login-box { background:#fff; padding:40px; border-radius:12px; width:360px; box-shadow:0 10px 40px rgba(0,0,0,.3); }
  </style>
</head>
<body>
  <div id="login-screen" class="login-screen">
    <div class="login-box">
      <div style="text-align:center;margin-bottom:24px">
        <i class="bi bi-shield-lock" style="font-size:2.5rem;color:#3498db"></i>
        <h5 class="mt-2 mb-1 fw-bold">ERP FYPC Viewer</h5>
        <p class="text-muted small mb-0">Ingrese sus credenciales</p>
      </div>
      <div class="mb-3"><input type="text" class="form-control" id="login-user" placeholder="Usuario" autocomplete="off"></div>
      <div class="mb-3"><input type="password" class="form-control" id="login-pass" placeholder="Contraseña"></div>
      <button class="btn btn-primary w-100 mb-2" onclick="doLogin()"><i class="bi bi-box-arrow-in-right me-2"></i>Ingresar</button>
      <div id="login-msg" class="text-danger small text-center"></div>
    </div>
  </div>
  <div id="app-container" style="display:none">
    <nav class="sidebar" id="sidebar"></nav>
    <main><div id="app-content"></div></main>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  <script>
    function getToken(){return localStorage.getItem('token')}
    function authHeaders(){const t=getToken();return t?{'Authorization':'Bearer '+t}:{}}
    async function handleRes(r){if(r.status===401){localStorage.removeItem('token');showLogin();throw{error:'Sesi\u00f3n expirada'}}return r}
    const API = {
      async get(u){const r=await handleRes(await fetch(u,{headers:authHeaders()}));if(!r.ok)throw await r.json();return r.json()},
      async post(u,b){const r=await handleRes(await fetch(u,{method:'POST',headers:{...authHeaders(),'Content-Type':'application/json'},body:JSON.stringify(b)}));if(!r.ok)throw await r.json();return r.json()},
      async put(u,b){const r=await handleRes(await fetch(u,{method:'PUT',headers:{...authHeaders(),'Content-Type':'application/json'},body:JSON.stringify(b)}));if(!r.ok)throw await r.json();return r.json()},
      async del(u){const r=await handleRes(await fetch(u,{method:'DELETE',headers:authHeaders()}));if(!r.ok)throw await r.json();return r.json()}
    };
    const $ = id => document.getElementById(id);
    const esc = s => { const d=document.createElement('div'); d.textContent=s??''; return d.innerHTML; };
    const fmt = (v,d) => v!=null&&v!=='' ? (d?Number(v).toFixed(d):v) : '';
    const money = v => v!=null ? `$${Number(v).toLocaleString('es',{minimumFractionDigits:2,maximumFractionDigits:2})}` : '';

    const MODULES = {
      dashboard: { icon:'speedometer2', label:'Dashboard' },
      comprobantes: { icon:'file-text', label:'Comprobantes' },
      clientes: { icon:'people', label:'Clientes' },
      proveedores: { icon:'truck', label:'Proveedores' },
      stock: { icon:'box', label:'Stock / Productos' },
      pedidos: { icon:'cart', label:'Pedidos' },
      movmercaderia: { icon:'arrow-left-right', label:'Mov. Mercadería' },
      movcaja: { icon:'cash', label:'Mov. Caja' },
      cobranzas: { icon:'receipt', label:'Recibos / Cta.Cte.' },
      ventas: { icon:'cart-check', label:'Ventas' },
      compras_tesoreria: { icon:'wallet', label:'Compras / Tesorería' },
      maestros: { icon:'bookmark-star', label:'Maestros' },
      ctacte: { icon:'wallet2', label:'Cta.Cte.' },
      produccion: { icon:'gear', label:'Producción' },
      logistica: { icon:'truck-flatbed', label:'Logística' },
      rrhh: { icon:'person-badge', label:'RRHH / Sueldos' },
      tesoreria: { icon:'piggy-bank', label:'Tesorería' },
      contabilidad: { icon:'journal', label:'Contabilidad' },
      impuestos: { icon:'file-earmark-text', label:'Impuestos' },
      obras: { icon:'building', label:'Obras / Licitaciones' },
      activosfijos: { icon:'tools', label:'Activos Fijos' },
      ecommerce: { icon:'shop', label:'E-Commerce' },
      crm: { icon:'headset', label:'CRM / Incidentes' },
      geografia: { icon:'geo-alt', label:'Geografía' },
      schema: { icon:'database', label:'Explorador BD' },
      auxiliares: { icon:'list', label:'Tablas Auxiliares' },
      usuarios: { icon:'person-lock', label:'Usuarios' },
    };
    let currentUser = null;
    try { currentUser = JSON.parse(localStorage.getItem('user')||'{}'); } catch(e){}

    const GROUPS = [
      { label:'Principales', items:['dashboard','comprobantes','clientes','proveedores','stock','pedidos','ventas'] },
      { label:'Movimientos', items:['movmercaderia','movcaja','produccion','logistica'] },
      { label:'Administración', items:['tesoreria','contabilidad','impuestos','cobranzas','ctacte','compras_tesoreria','obras','activosfijos'] },
      { label:'RRHH', items:['rrhh'] },
      { label:'Comercio Exterior', items:['ecommerce','crm'] },
      { label:'Sistema', items:['geografia','schema','auxiliares','usuarios'] },
    ];

    let currentModule = 'dashboard', currentData = [];
    let moduleCache = {};

    function buildSidebar() {
      const u=currentUser;
      let html = `<div class="brand"><h6><i class="bi bi-database me-2"></i>ERP FYPC</h6><small>${u.nombre||u.username||''}</small></div>`;
      GROUPS.forEach(g => {
        html += `<div class="mod-group">${g.label}</div>`;
        g.items.forEach(m => {
          const mod = MODULES[m];
          if (!mod) return;
          html += `<a class="nav-link" href="#" data-module="${m}"><i class="bi bi-${mod.icon}"></i>${mod.label}</a>`;
        });
      });
      html += `<div style="padding:10px 16px;border-top:1px solid #1f2d3d;margin-top:auto">
        <a href="#" onclick="doLogout()" class="nav-link" style="display:flex;align-items:center;gap:8px;color:#8899aa">
          <i class="bi bi-box-arrow-right"></i>Cerrar sesi\u00f3n</a></div>`;
      $('sidebar').innerHTML = html;
      document.querySelectorAll('.sidebar .nav-link').forEach(a => {
        a.addEventListener('click', e => { e.preventDefault(); loadModule(a.dataset.module); });
      });
    }

    function renderLoading() { return '<div class="loading"><div class="spinner-border text-primary" role="status"></div><p class="mt-2 text-muted">Cargando...</p></div>'; }

    let sortGlob = { col: '', dir: 'asc', fn: null };

    function buildSortableTable(cols, data) {
      if (!data||!data.length) return '<div class="alert alert-info m-3">Sin resultados</div>';
      let h = '<div class="table-wrap"><table class="table table-sm table-hover mb-0"><thead><tr>';
      cols.forEach(c => {
        const active = sortGlob.col === c.key;
        h += `<th style="cursor:pointer" onclick="sortCob('${c.key}')">${c.label} ${active ? (sortGlob.dir==='asc'?'▲':'▼') : '⇅'}</th>`;
      });
      h += '</tr></thead><tbody>';
      let sorted = [...data];
      if (sortGlob.col) {
        const k = sortGlob.col, d = sortGlob.dir;
        sorted.sort((a,b) => {
          let va = a[k], vb = b[k];
          if (va == null) va = ''; if (vb == null) vb = '';
          if (typeof va === 'number') return d==='asc' ? va-vb : vb-va;
          return d==='asc' ? String(va).localeCompare(String(vb)) : String(vb).localeCompare(String(va));
        });
      }
      sorted.forEach((r,i) => {
        h += '<tr>';
        cols.forEach(c => {
          let v = c.render ? c.render(r[c.key]) : esc(r[c.key]);
          h += `<td>${v}</td>`;
        });
        h += '</tr>';
      });
      h += '</tbody></table></div>';
      if (data.length >= 500) h += '<p class="text-muted small px-3 pb-2">Mostrando hasta 500 registros</p>';
      return h;
    }

    window.sortCob = (col) => {
      if (sortGlob.col === col) sortGlob.dir = sortGlob.dir === 'asc' ? 'desc' : 'asc';
      else { sortGlob.col = col; sortGlob.dir = 'asc'; }
      loadCobTab();
    };

    function buildTable(cols, data, rowKey) {
      if (!data||!data.length) return '<div class="alert alert-info m-3">Sin resultados</div>';
      let h = '<div class="table-wrap"><table class="table table-sm table-hover mb-0"><thead><tr>';
      cols.forEach(c => { h+=`<th>${c.label}</th>`; });
      h+='</tr></thead><tbody>';
      data.forEach((r,i) => {
        const key = rowKey ? r[rowKey] : i;
        h+=`<tr class="row-click" onclick="showDetail('${key}')">`;
        cols.forEach(c => {
          let v = c.render ? c.render(r[c.key]) : esc(r[c.key]);
          h+=`<td>${v}</td>`;
        });
        h+='</tr>';
      });
      h+='</tbody></table></div>';
      if(data.length>=500) h+='<p class="text-muted small px-3 pb-2">Mostrando hasta 500 registros</p>';
      return h;
    }

    function buildSearchInput(placeholder) {
      return `<div class="row g-2 mb-3 align-items-center">
        <div class="col-md-5">
          <div class="input-group input-group-sm search-box">
            <input type="text" class="form-control" id="s" placeholder="${placeholder}">
            <button class="btn btn-primary" onclick="doSearch()"><i class="bi bi-search"></i></button>
            <button class="btn btn-outline-secondary" onclick="clearSearch()"><i class="bi bi-x-lg"></i></button>
          </div>
        </div>
        <div class="col-md-2"><input type="date" class="form-control form-control-sm" id="fd"></div>
        <div class="col-md-2"><input type="date" class="form-control form-control-sm" id="fh"></div>
        <div class="col-md-1"><select class="form-select form-select-sm" id="lim"><option value="100">100</option><option value="500" selected>500</option><option value="1000">1000</option></select></div>
      </div>
      <div id="r"></div><div id="d"></div>`;
    }

    function sp() {
      const p=new URLSearchParams();
      const s=$('s')?.value; if(s) p.set('search',s);
      const fd=$('fd')?.value; if(fd) p.set('desde',fd);
      const fh=$('fh')?.value; if(fh) p.set('hasta',fh);
      p.set('limit',$('lim')?.value||'500');
      return p.toString();
    }

    function doSearch() { loadModule(currentModule); }
    function clearSearch() { ['s','fd','fh'].forEach(id=>{const e=$(id);if(e)e.value='';}); doSearch(); }

    function showDetail(id) {
      const fn = DETAIL_FUNCS[currentModule];
      if (fn) fn(id);
    }

    function renderSimple(endpoint, cols, rowKey, title, placeholder) {
      $('app-content').innerHTML = `<div class="module-header"><h4><i class="bi bi-${MODULES[currentModule]?.icon||'table'}"></i>${title}</h4></div>${buildSearchInput(placeholder||'Buscar...')}<div id="r"></div>`;
      const r=$('r'); r.innerHTML=renderLoading();
      API.get(`/api/${endpoint}?${sp()}`).then(d=>{currentData=d;r.innerHTML=buildTable(cols,d,rowKey);}).catch(e=>{r.innerHTML=`<div class="alert alert-danger">${e.error||e.message}</div>`;});
    }

    function loadModule(mod) {
      currentModule = mod;
      document.querySelectorAll('.sidebar .nav-link').forEach(l=>l.classList.remove('active'));
      document.querySelector(`.nav-link[data-module="${mod}"]`)?.classList.add('active');
      const fn = MODULE_FUNCS[mod];
      if (fn) fn();
      else $('app-content').innerHTML = '<div class="alert alert-warning">Módulo no implementado</div>';
    }

    function renderTabs(tabs, defaultTab, contentFn) {
      let h = `<ul class="nav nav-tabs mb-3" id="tabs">`;
      tabs.forEach((t,i) => { h+=`<li class="nav-item"><a class="nav-link ${i===0?'active':''}" href="#" data-tab="${t.id}">${t.label}</a></li>`; });
      h+=`</ul><div id="tabc"></div>`;
      $('app-content').innerHTML = h;
      contentFn(tabs[0].id);
      document.querySelectorAll('#tabs .nav-link').forEach(a => {
        a.addEventListener('click', e => {
          e.preventDefault();
          document.querySelectorAll('#tabs .nav-link').forEach(l=>l.classList.remove('active'));
          a.classList.add('active');
          contentFn(a.dataset.tab);
        });
      });
    }

    async function tabContent(endpointMap, tabId, title) {
      const c = $('tabc');
      c.innerHTML = renderLoading();
      const ep = endpointMap[tabId];
      if (!ep) { c.innerHTML='<div class="alert alert-info">Seleccione una pestaña</div>'; return; }
      try {
        const d = await API.get(`/api/${ep}?limit=300`);
        c.innerHTML = `<div class="card"><div class="card-header">${title||'Datos'}</div><div class="card-body p-0">${buildTable(epCols(ep)||[{key:'id',label:'ID'}],d)}</div></div>`;
      } catch(e) { c.innerHTML=`<div class="alert alert-danger">${e.error||e.message}</div>`; }
    }

    function epCols(ep) {
      const MAP = {
        'rrhh/empleados': [{key:'codigo',label:'Cód'},{key:'nombre',label:'Nombre'},{key:'documento',label:'Doc'},{key:'cuil',label:'CUIL'},{key:'area_nombre',label:'Area'},{key:'categoria_nombre',label:'Categoría'},{key:'puesto_nombre',label:'Puesto'},{key:'fechaing',label:'Ingreso'},{key:'estado',label:'Estado',render:v=>v==1?'Activo':'Inactivo'}],
        'rrhh/liquidaciones': [{key:'id',label:'ID'},{key:'nombre',label:'Nombre'},{key:'fecha',label:'Fecha'},{key:'tipo',label:'Tipo'},{key:'periodo_nombre',label:'Período'},{key:'apertura',label:'Apertura'},{key:'cierre',label:'Cierre'},{key:'fechapag',label:'Pago'}],
        'rrhh/novedades': [{key:'id',label:'ID'},{key:'empleado_nombre',label:'Empleado'},{key:'periodoid',label:'Período'}],
        'rrhh/conceptos': [{key:'id',label:'ID'},{key:'nombre',label:'Nombre'},{key:'tipo',label:'Tipo'},{key:'importe',label:'Importe',render:money},{key:'tipoliq',label:'TipoLiq'}],
        'produccion/ordenes': [{key:'numero',label:'Nro'},{key:'fecha',label:'Fecha'},{key:'proceso_nombre',label:'Proceso'},{key:'programa_nombre',label:'Programa'},{key:'obra_nombre',label:'Obra'},{key:'estadointerno',label:'Estado'}],
        'produccion/procesos': [{key:'id',label:'ID'},{key:'nombre',label:'Nombre'},{key:'sector_nombre',label:'Sector'},{key:'tiempo',label:'Tiempo'},{key:'costo',label:'Costo',render:money}],
        'logistica/rutas': [{key:'id',label:'ID'},{key:'detalle',label:'Detalle'},{key:'transporteid',label:'Transporte'},{key:'conductorid',label:'Conductor'},{key:'depositoid',label:'Depósito'},{key:'direccion',label:'Dirección'},{key:'localidad',label:'Localidad'}],
        'logistica/hruta': [{key:'id',label:'ID'},{key:'ruta_nombre',label:'Ruta'},{key:'fecha',label:'Fecha'},{key:'estado_nombre',label:'Estado'},{key:'detalle',label:'Detalle'},{key:'volumen',label:'Volumen'},{key:'peso',label:'Peso'},{key:'transporteid',label:'Transporte'},{key:'conductorid',label:'Conductor'}],
        'logistica/hrutai': [{key:'id',label:'ID'},{key:'detalle',label:'Detalle'}],
        'logistica/hestados': [{key:'id',label:'ID'},{key:'detalle',label:'Detalle'},{key:'accion',label:'Acción'}],
        'logistica/rutaclientes': [{key:'id',label:'ID'},{key:'ruta_nombre',label:'Ruta'},{key:'cli_nombre',label:'Cliente'},{key:'detalle',label:'Detalle'},{key:'orden',label:'Orden'},{key:'activo',label:'Activo'}],
        'logistica/rutadocs': [{key:'id',label:'ID'},{key:'ruta_nombre',label:'Ruta'},{key:'documentoid',label:'Documento'},{key:'detalle',label:'Detalle'},{key:'clase',label:'Clase'}],
        'logistica/configdocs': [{key:'id',label:'ID'},{key:'detalle',label:'Detalle'},{key:'codigo',label:'Código'}],
        'logistica/camiones': [{key:'codigo',label:'Cód'},{key:'patente',label:'Patente'},{key:'detalle',label:'Detalle'},{key:'chofer',label:'Chofer'},{key:'chasis',label:'Chasis'},{key:'tara',label:'Tara'},{key:'cargamax',label:'Carga Max'}],
        'logistica/choferes': [{key:'codigo',label:'Cód'},{key:'nombre',label:'Nombre'},{key:'documento',label:'Doc'},{key:'camion',label:'Camión'}],
        'logistica/despachos': [{key:'codigo',label:'Cód'},{key:'numero',label:'Nro'},{key:'detalle',label:'Detalle'},{key:'fembarque',label:'Embarca'},{key:'fpartida',label:'Partida'},{key:'farribo',label:'Arriba'},{key:'buque',label:'Buque'},{key:'carpeta',label:'Carpeta'},{key:'flete',label:'Flete'}],
        'obras/licitaciones': [{key:'licitacion',label:'Licitación'},{key:'fecha',label:'Fecha'},{key:'obra_nombre',label:'Obra'},{key:'tipo_nombre',label:'Tipo'},{key:'estado_nombre',label:'Estado'},{key:'expediente',label:'Expediente'},{key:'presup_imp',label:'Presup',render:money}],
        'obras/polizas': [{key:'poliza',label:'Póliza'},{key:'asegura',label:'Aseguradora'},{key:'fechaemi',label:'Emisión'},{key:'fechaven',label:'Venc'},{key:'obra_nombre',label:'Obra'},{key:'suma_imp',label:'Suma',render:money},{key:'estado_nombre',label:'Estado'}],
        'ecommerce/productos': [{key:'nombre',label:'Nombre'},{key:'stock_detalle',label:'Artículo'},{key:'precio',label:'Precio',render:money},{key:'categoria_nombre',label:'Categoría'},{key:'tipo_nombre',label:'Tipo'},{key:'estado_nombre',label:'Estado'},{key:'moneda',label:'Moneda'}],
        'impuestos/percepciones': [{key:'id',label:'ID',render:v=>v?v.substring(0,8):''},{key:'label',label:'Nombre'},{key:'alicuota',label:'Alic %',render:v=>v?`${v}%`:''},{key:'tipo_nombre',label:'Tipo'},{key:'jurisdiccion',label:'Jurisd.'},{key:'modulo',label:'Módulo'},{key:'padron',label:'Padrón'}],
        'impuestos/retenciones': [{key:'id',label:'ID',render:v=>v?v.substring(0,8):''},{key:'label',label:'Retención'},{key:'campo',label:'Campo'},{key:'tipo',label:'Tipo'},{key:'modulo',label:'Módulo'},{key:'alicuotaprov',label:'AlicProv'}],
