    window.showUserForm = async (id) => {
      let user = {username:'',nombre:'',password:'',role:'user'};
      if (id) {
        const users = await API.get('/api/auth/users');
        user = users.find(u=>u.id===id) || user;
      }
      const isEdit = !!id;
      const mBody = $('modalBody');
      mBody.innerHTML = `<div class="p-2">
        <div class="mb-3"><label class="form-label small">Usuario</label><input class="form-control form-control-sm" id="uf-user" value="${esc(user.username)}"></div>
