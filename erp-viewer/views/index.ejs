        <div class="mb-3"><label class="form-label small">Contraseña${isEdit?' (dejar vacío para mantener)':''}</label><input type="password" class="form-control form-control-sm" id="uf-pass"></div>
        <div class="mb-3"><label class="form-label small">Rol</label>
          <select class="form-select form-select-sm" id="uf-role">
            <option value="user" ${user.role==='user'?'selected':''}>Usuario</option>
            <option value="admin" ${user.role==='admin'?'selected':''}>Administrador</option>
          </select></div>
        ${isEdit?`<div class="mb-3"><div class="form-check"><input class="form-check-input" type="checkbox" id="uf-activo" ${user.activo?'checked':''}><label class="form-check-label small">Activo</label></div></div>`:''}
        <button class="btn btn-primary btn-sm w-100" onclick="saveUser(${id||''})"><i class="bi bi-check-lg"></i> ${isEdit?'Guardar Cambios':'Crear Usuario'}</button></div>`;
      $('modalTitle').innerHTML = isEdit ? `<i class="bi bi-pencil me-2"></i>Editar Usuario` : `<i class="bi bi-plus-lg me-2"></i>Nuevo Usuario`;
      bootstrap.Modal.getOrCreateInstance('#detalleModal').show();
