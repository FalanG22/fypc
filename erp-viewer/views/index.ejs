    }
    async function doLogin(){
      const u=document.getElementById('login-user').value,p=document.getElementById('login-pass').value;
      if(!u||!p)return;
      document.getElementById('login-msg').textContent='Ingresando...';
      try{
        const r=await fetch('/api/auth/login',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({username:u,password:p})});
        if(!r.ok){const e=await r.json();document.getElementById('login-msg').textContent=e.error||'Error';return}
        const d=await r.json();
        localStorage.setItem('token',d.token);
        localStorage.setItem('user',JSON.stringify(d.user));
        currentUser=d.user;
        document.getElementById('login-screen').style.display='none';
        document.getElementById('app-container').style.display='';
        buildSidebar();loadModule('dashboard');
      }catch(e){document.getElementById('login-msg').textContent='Error de conexi\u00f3n'}
    }
    function doLogout(){localStorage.removeItem('token');localStorage.removeItem('user');currentUser={};showLogin()}
    document.getElementById('login-pass').addEventListener('keydown',e=>{if(e.key==='Enter')doLogin()});

    const token=getToken();
    if(token){
      API.get('/api/auth/me').then(u=>{
        currentUser=u;
        localStorage.setItem('user',JSON.stringify(u));
        document.getElementById('login-screen').style.display='none';
        document.getElementById('app-container').style.display='';
        buildSidebar();loadModule('dashboard');
      }).catch(()=>showLogin());
    }else{showLogin()}
  </script>

  <div class="modal fade" id="detalleModal" tabindex="-1" aria-hidden="true" data-bs-backdrop="static">
    <div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable">
      <div class="modal-content">
        <div class="modal-header py-2">
          <h6 class="modal-title" id="modalTitle"><i class="bi bi-file-text me-2"></i>Detalle</h6>
          <button type="button" class="btn-close btn-sm" data-bs-dismiss="modal"></button>
        </div>
        <div class="modal-body p-3" id="modalBody"></div>
      </div>
    </div>
  </div>
</body>
</html>
