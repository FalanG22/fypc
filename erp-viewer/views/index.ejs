      ventas: async (id) => {
        $('modalBody').innerHTML = '<div class="text-center py-5"><div class="spinner-border text-primary"></div><p class="mt-2 text-muted">Cargando...</p></div>';
        const modal = new bootstrap.Modal('#detalleModal');
        modal.show();
        try {
          const [cab, det] = await Promise.all([
            API.get(`/api/ventas/${id}`),
            API.get(`/api/ventas/${id}/detalle`)
          ]);
          let netoH = parseFloat(cab.neto)||0;
          let ivaH = parseFloat(cab.iva)||0;
          let exentoH = parseFloat(cab.exento)||0;
          let percepcionH = parseFloat(cab.percepcion)||0;
          let totalReal = netoH + exentoH + percepcionH;
          $('modalTitle').innerHTML = `<i class="bi bi-receipt me-2"></i>Factura: ${cab.comp} - ${esc(cab.nombre||cab.cliente)}`;
          let h = `<div class="row"><div class="col-md-5"><div class="detail-panel"><dl>`;
          [['Nro',cab.comp],['Tipo',cab.codigo],['Fecha',cab.fecha],['Vencimiento',cab.fechaven],
           ['Cliente',cab.nombre],['CUIT',cab.cuit],['Vendedor',cab.vendedor_nombre||cab.vendedor],
           ['Forma Pago',cab.pago_nombre||cab.pago],['Moneda',cab.moneda],['Remito',cab.remito],
           ['CAE',cab.cae||cab.campocae],
           ['Subtotal (renglones)',money(netoH-ivaH-(cab.impuestoaux1||0)-(cab.impuestoaux2||0)-(cab.impuestoaux3||0))],['IVA',money(ivaH)],
           ((cab.impuestoaux1||0)!=0?['Imp.Aux.1',money(cab.impuestoaux1)]:null),
           ((cab.impuestoaux2||0)!=0?['Imp.Aux.2',money(cab.impuestoaux2)]:null),
           ((cab.impuestoaux3||0)!=0?['Imp.Aux.3',money(cab.impuestoaux3)]:null),
           ['Neto (según TANGO)',money(netoH)],
           (exentoH?['Exento',money(exentoH)]:null),(percepcionH?['Percepción',money(percepcionH)]:null),
           ['Total',money(totalReal)],['Estado',cab.estadodoc]].filter(Boolean).forEach(([l,v])=>{h+=`<dt>${l}</dt><dd>${esc(v)}</dd>`;});
          h+=`</dl></div></div><div class="col-md-7"><h6 class="mb-2">Renglones (${det.length})</h6>`;
          if (det.length > 0) {
            let sumaDet = det.reduce((s,r) => s + (parseFloat(r.subtotal)||0), 0);
            let ivaH = parseFloat(cab.iva)||0;
            let aux1 = parseFloat(cab.impuestoaux1)||0;
            let aux2 = parseFloat(cab.impuestoaux2)||0;
            let aux3 = parseFloat(cab.impuestoaux3)||0;
            let netoH = parseFloat(cab.neto)||0;
            let reconciling = Math.abs(netoH - (sumaDet + ivaH + aux1 + aux2 + aux3));
            h += `<div class="alert alert-info py-2 small mb-2">
              <strong>L&oacute;gica de TANGO:</strong> El campo <code>neto</code> del comprobante =
              Suma de renglones + IVA + Imp.Aux.1+2+3<br>
              <code>${money(sumaDet)} + ${money(ivaH)}${aux1?' + '+money(aux1):''}${aux2?' + '+money(aux2):''}${aux3?' + '+money(aux3):''}
              = ${money(sumaDet+ivaH+aux1+aux2+aux3)}</code>
              ${reconciling < 1 ? ' ✅ <strong>Coincide con el neto del comprobante</strong>' : ' ⚠️ Diferencia: '+money(reconciling)}
            </div>`;
            h += buildTable([
              {key:'clave',label:'Cód'},{key:'art_detalle',label:'Artículo'},
              {key:'cantidad',label:'Cant',render:v=>Number(v||0).toFixed(2)},
              {key:'precio_unitario',label:'P.Unit',render:money},
              {key:'subtotal',label:'Subtotal',render:money},
              {key:'descuento',label:'Desc.%',render:v=>v?`${v}%`:''},
              {key:'iva',label:'IVA%',render:v=>v?`${v}%`:''}
            ], det);
          } else {
            h += '<div class="alert alert-info">Sin detalle de renglones</div>';
          }
          h += `</div></div>`;
          $('modalBody').innerHTML = h;
        } catch(e){
          $('modalBody').innerHTML = `<div class="alert alert-danger mb-0">${e.error||e.message}</div>`;
        }
      },
    };

