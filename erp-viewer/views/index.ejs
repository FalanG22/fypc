<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>ERP FYPC Viewer</title>
  <link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'><rect width='32' height='32' rx='6' fill='%233498db'/><text x='16' y='23' text-anchor='middle' font-size='20' font-weight='bold' fill='white' font-family='Arial'>F</text></svg>">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.7/dist/chart.umd.min.js"></script>
  <style>
    :root {
      --sidebar-bg: #0f1419;
      --sidebar-width: 230px;
      --accent: #3b82f6;
      --accent-light: #60a5fa;
      --accent-dark: #1d4ed8;
      --text-muted: #64748b;
      --card-shadow: 0 8px 32px rgba(0,0,0,.06), 0 2px 8px rgba(0,0,0,.04);
      --card-hover-shadow: 0 16px 48px rgba(0,0,0,.10), 0 4px 16px rgba(0,0,0,.06);
      --radius: 12px;
      --radius-sm: 8px;
      --glass-bg: rgba(255,255,255,0.55);
      --glass-border: rgba(255,255,255,0.3);
      --glass-blur: 14px;
      --glass-card-bg: rgba(255,255,255,0.6);
      --sidebar-glass: rgba(15,20,25,0.88);
    }
    * { box-sizing: border-box; }
    body {
      font-size: .8rem;
      min-height: 100vh;
      background: linear-gradient(135deg, #eef2ff 0%, #f5f3ff 40%, #fce7f3 70%, #eef2ff 100%);
      background-attachment: fixed;
      font-family: 'Inter','Segoe UI',system-ui,sans-serif;
      -webkit-font-smoothing: antialiased;
    }
    body::before {
      content: '';
      position: fixed;
      inset: 0;
      background: radial-gradient(ellipse 60% 50% at 20% 30%, rgba(59,130,246,.06) 0%, transparent 70%),
                  radial-gradient(ellipse 50% 40% at 80% 70%, rgba(168,85,247,.05) 0%, transparent 70%);
      pointer-events: none;
      z-index: 0;
    }

    ::-webkit-scrollbar { width: 5px; height: 5px; }
    ::-webkit-scrollbar-track { background: transparent; }
    ::-webkit-scrollbar-thumb { background: #cbd5e1; border-radius: 10px; }
    ::-webkit-scrollbar-thumb:hover { background: #94a3b8; }

    /* === SIDEBAR === */
    .sidebar {
      position: fixed; top: 0; bottom: 0; left: 0;
      z-index: 100; padding: 0;
      width: var(--sidebar-width);
      background: var(--sidebar-glass);
      backdrop-filter: blur(20px);
      -webkit-backdrop-filter: blur(20px);
      border-right: 1px solid rgba(255,255,255,.06);
      overflow-y: auto; display: flex; flex-direction: column;
    }
    .sidebar::-webkit-scrollbar { width: 3px; }
    .sidebar::-webkit-scrollbar-thumb { background: #1e293b; border-radius: 10px; }
    .sidebar .brand { padding: 16px 18px; border-bottom: 1px solid rgba(255,255,255,.06); }
    .sidebar .brand h6 { color: #f1f5f9; font-size: .85rem; margin: 0; letter-spacing: .5px; font-weight: 700; }
    .sidebar .brand h6 i { color: var(--accent-light); }
    .sidebar .brand small { color: #475569; font-size: .65rem; }
    .sidebar .mod-group { padding: 14px 18px 4px; color: #475569; font-size: .6rem; text-transform: uppercase; letter-spacing: 1.2px; font-weight: 700; }
    .sidebar .nav-link { color: #64748b; padding: 7px 18px; font-size: .78rem; border-left: 2px solid transparent; transition: all .15s; font-weight: 450; }
    .sidebar .nav-link:hover { color: #e2e8f0; background: rgba(255,255,255,.04); border-left-color: var(--accent); }
    .sidebar .nav-link.active { color: #fff; background: rgba(59,130,246,.12); border-left-color: var(--accent); font-weight: 500; }
    .sidebar .nav-link i { margin-right: 8px; width: 16px; text-align: center; font-size: .75rem; color: var(--accent-light); opacity: .6; }
    .sidebar .nav-link.active i { opacity: 1; }

    .sidebar-overlay {
      display: none;
      position: fixed;
      inset: 0;
      z-index: 99;
      background: rgba(0,0,0,.4);
      backdrop-filter: blur(4px);
      -webkit-backdrop-filter: blur(4px);
    }
    .sidebar-overlay.active { display: block; }

    #sidebarToggle {
      display: none;
      position: fixed;
      top: 12px;
      left: 12px;
      z-index: 102;
      width: 36px;
      height: 36px;
      border: 1px solid rgba(255,255,255,.15);
      border-radius: 8px;
      background: rgba(15,20,25,0.7);
      backdrop-filter: blur(10px);
      -webkit-backdrop-filter: blur(10px);
      color: #fff;
      font-size: 1.1rem;
      cursor: pointer;
      align-items: center;
      justify-content: center;
      transition: background .15s;
    }
    #sidebarToggle:hover { background: rgba(15,20,25,0.9); }

    /* === MAIN CONTENT === */
    main {
      margin-left: var(--sidebar-width);
      padding: 24px 28px;
      min-height: 100vh;
      position: relative;
      z-index: 1;
    }

    /* === GLASS CARDS === */
    .card {
      border: 1px solid var(--glass-border);
      border-radius: var(--radius);
      box-shadow: 0 8px 32px rgba(0,0,0,.05), 0 1px 4px rgba(0,0,0,.03);
      margin-bottom: 16px;
      background: var(--glass-card-bg);
      backdrop-filter: blur(var(--glass-blur));
      -webkit-backdrop-filter: blur(var(--glass-blur));
      transition: box-shadow .25s, transform .2s, background .2s;
    }
    .card:hover {
      box-shadow: 0 16px 48px rgba(0,0,0,.08), 0 4px 16px rgba(0,0,0,.04);
      background: rgba(255,255,255,0.7);
    }
    .card-header {
      background: rgba(255,255,255,0.5);
      border-bottom: 1px solid rgba(226,232,240,.5);
      font-weight: 600; padding: 12px 20px;
      font-size: .82rem;
      border-radius: calc(var(--radius) - 1px) calc(var(--radius) - 1px) 0 0 !important;
      color: #1e293b;
    }

    /* === STAT CARDS (GLASS) === */
    .stat-card {
      padding: 20px; text-align: center;
      border-radius: var(--radius);
      transition: all .25s cubic-bezier(.4,0,.2,1);
      position: relative; overflow: hidden; cursor: default;
      border: 1px solid var(--glass-border);
      backdrop-filter: blur(var(--glass-blur));
      -webkit-backdrop-filter: blur(var(--glass-blur));
    }
    .stat-card:hover {
      transform: translateY(-4px);
      box-shadow: 0 16px 48px rgba(0,0,0,.08), 0 4px 16px rgba(0,0,0,.04);
    }
    .stat-card .number {
      font-size: 1.8rem; font-weight: 800;
      color: #0f172a; letter-spacing: -1px;
      line-height: 1.1; margin: 6px 0 2px;
    }
    .stat-card .label {
      color: var(--text-muted); font-size: .68rem;
      text-transform: uppercase; letter-spacing: .6px; font-weight: 600;
    }
    .stat-card i { font-size: 1.3rem; margin-bottom: 4px; display: inline-block; }
    .stat-card .stat-bar {
      position: absolute; top: 0; left: 0; right: 0;
      height: 3px;
      border-radius: var(--radius) var(--radius) 0 0;
    }

    /* === TABLES (solid bg for readability inside glass) === */
    .table th {
      font-weight: 600; color: #475569; font-size: .68rem;
      text-transform: uppercase; white-space: nowrap;
      background: rgba(248,250,252,.85);
      border-bottom: 1px solid #e2e8f0;
      padding: 10px 12px !important; letter-spacing: .3px;
    }
    .table td {
      vertical-align: middle; font-size: .76rem;
      padding: 8px 12px !important; max-width: 250px;
      overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
      border-bottom: 1px solid rgba(241,245,249,.7);
    }
    .table tbody tr { transition: background .1s; }
    .table tbody tr:last-child td { border-bottom: none; }
    .table-wrap {
      max-height: 65vh; overflow-y: auto;
      border-radius: 0 0 var(--radius) var(--radius);
      background: rgba(255,255,255,.45);
    }
    .table-wrap thead { position: sticky; top: 0; z-index: 2; }
    .table-wrap thead th { position: sticky; top: 0; }

    /* === DETAIL PANEL (glass inside cards) === */
    .detail-panel {
      background: rgba(248,250,252,.6);
      backdrop-filter: blur(8px);
      -webkit-backdrop-filter: blur(8px);
      border-radius: var(--radius-sm);
      padding: 16px;
      border: 1px solid rgba(226,232,240,.4);
    }
    .detail-panel dt {
      font-size: .65rem; color: var(--text-muted);
      text-transform: uppercase; letter-spacing: .4px;
      margin-top: 8px; font-weight: 600;
    }
    .detail-panel dd { margin-bottom: 2px; font-size: .82rem; color: #1e293b; }

    .search-box { max-width: 380px; }

    /* === NAV TABS (glass) === */
    .nav-tabs {
      border-bottom: 1px solid rgba(226,232,240,.5);
      gap: 0;
    }
    .nav-tabs .nav-link {
      font-size: .78rem; padding: 8px 16px;
      color: var(--text-muted);
      border: none; border-bottom: 2px solid transparent;
      transition: all .15s; margin: 0;
    }
    .nav-tabs .nav-link:hover { color: #1e293b; border-color: transparent; background: transparent; }
    .nav-tabs .nav-link.active {
      color: var(--accent); font-weight: 600;
      border-bottom-color: var(--accent); background: transparent;
    }

    .badge { font-size: .65rem; font-weight: 500; padding: 4px 8px; border-radius: 6px; }
    .loading { text-align: center; padding: 60px 20px; }
    .loading .spinner-border { width: 2.5rem; height: 2.5rem; color: var(--accent); }
    .row-click { cursor: pointer; }
    .row-click:hover { background: rgba(59,130,246,.08) !important; }

    .module-header { margin-bottom: 20px; }
    .module-header h4 {
      font-size: 1.15rem; font-weight: 700; color: #0f172a;
      text-shadow: 0 1px 2px rgba(255,255,255,.5);
    }
    .module-header h4 i { color: var(--accent); margin-right: 8px; }

    .btn-sm { font-size: .75rem; }
    .form-control, .form-select {
      font-size: .82rem;
      border: 1px solid rgba(226,232,240,.6);
      border-radius: var(--radius-sm);
      background: rgba(255,255,255,.7);
      backdrop-filter: blur(4px);
      -webkit-backdrop-filter: blur(4px);
    }
    .form-control:focus, .form-select:focus {
      border-color: var(--accent);
      box-shadow: 0 0 0 3px rgba(59,130,246,.12);
      background: rgba(255,255,255,.9);
    }
    .form-control-sm, .form-select-sm { font-size: .78rem; }

    /* === LOGIN SCREEN (KEPT UNCHANGED) === */
    .login-screen { display:flex; align-items:center; justify-content:flex-start; min-height:100vh; background: url('/fypc.png') center/cover no-repeat fixed; position:relative; padding-left:8%; }
    .login-screen::before { content:''; position:absolute; inset:0; background: rgba(0,0,0,.55); }
    .login-box { position:relative; background:rgba(255,255,255,.12); backdrop-filter:blur(18px); -webkit-backdrop-filter:blur(18px); padding:44px; border-radius:20px; width:380px; box-shadow: 0 25px 60px rgba(0,0,0,.3); border:1px solid rgba(255,255,255,.2); color:#fff; }
    .login-box input { background:rgba(255,255,255,.1); border:1px solid rgba(255,255,255,.2); color:#fff; }
    .login-box input:focus { background:rgba(255,255,255,.15); border-color:rgba(255,255,255,.4); color:#fff; box-shadow:0 0 0 3px rgba(255,255,255,.1); }
    .login-box input::placeholder { color:rgba(255,255,255,.5); }
    .login-box .text-muted { color:rgba(255,255,255,.6) !important; }
    .login-box .btn-primary { background:rgba(255,255,255,.2); border:1px solid rgba(255,255,255,.3); backdrop-filter:blur(4px); }
    .login-box .btn-primary:hover { background:rgba(255,255,255,.3); border-color:rgba(255,255,255,.5); }
    .login-box .text-danger { color:#fca5a5 !important; }

    .chart-card {
      background: var(--glass-card-bg);
      backdrop-filter: blur(var(--glass-blur));
      -webkit-backdrop-filter: blur(var(--glass-blur));
      border: 1px solid var(--glass-border);
      border-radius: var(--radius);
      box-shadow: var(--card-shadow);
      padding: 20px;
    }

    @keyframes fadeUp {
      from { opacity: 0; transform: translateY(12px); }
      to { opacity: 1; transform: translateY(0); }
    }
    @keyframes glassIn {
      from { opacity: 0; transform: translateY(8px) scale(.98); }
      to { opacity: 1; transform: translateY(0) scale(1); }
    }
    .ani-fade { animation: fadeUp .4s ease both; }

    /* === MODAL GLASS === */
    .modal-content {
      background: rgba(255,255,255,.7);
      backdrop-filter: blur(20px);
      -webkit-backdrop-filter: blur(20px);
      border: 1px solid var(--glass-border);
    }
    .modal-header {
      background: rgba(255,255,255,.4);
      border-bottom: 1px solid rgba(226,232,240,.4);
    }

    /* === RESPONSIVE === */
    @media (max-width: 1023px) {
      .sidebar {
        transform: translateX(-100%);
        transition: transform .3s cubic-bezier(.4,0,.2,1);
      }
      .sidebar.open { transform: translateX(0); }
      #sidebarToggle { display: flex; }
      main {
        margin-left: 0;
        padding: 24px 20px;
      }
    }
    @media (min-width: 1024px) {
      .sidebar-overlay { display: none !important; }
      .sidebar { transform: none !important; }
    }
    @media (max-width: 767px) {
      main { padding: 60px 12px 20px; }
      .container-fluid > .row > [class*="col-"] { padding: 0 4px; }
      .card-header { padding: 10px 14px; font-size: .78rem; }
      .stat-card { padding: 14px; }
      .stat-card .number { font-size: 1.4rem; }
      .login-screen { padding-left: 16px; padding-right: 16px; justify-content: center; }
      .login-box { width: 100%; max-width: 360px; padding: 32px 24px; }
      .nav-tabs { overflow-x: auto; flex-wrap: nowrap; -webkit-overflow-scrolling: touch; }
      .nav-tabs .nav-link { white-space: nowrap; padding: 8px 12px; font-size: .72rem; }
      .table-wrap { max-height: 50vh; }
      .table td, .table th { padding: 6px 8px !important; font-size: .7rem; }
      body { font-size: .75rem; }
    }
  </style>
</head>
<body>
  <div id="login-screen" class="login-screen">
    <div class="login-box">
      <div style="text-align:center;margin-bottom:24px">
        <i class="bi bi-shield-lock" style="font-size:2.5rem;color:#fff;opacity:.8"></i>
        <h5 class="mt-2 mb-1 fw-bold" style="color:#fff">ERP FYPC Viewer</h5>
        <p class="text-muted small mb-0">Ingrese sus credenciales</p>
      </div>
      <div class="mb-3"><input type="text" class="form-control" id="login-user" placeholder="Usuario" autocomplete="off"></div>
      <div class="mb-3"><input type="password" class="form-control" id="login-pass" placeholder="Contraseña"></div>
      <button class="btn btn-primary w-100 mb-2" onclick="doLogin()"><i class="bi bi-box-arrow-in-right me-2"></i>Ingresar</button>
      <div id="login-msg" class="text-danger small text-center"></div>
    </div>
  </div>
  <div id="app-container" style="display:none">
    <div class="sidebar-overlay" id="sidebarOverlay"></div>
    <button id="sidebarToggle" onclick="toggleSidebar()"><i class="bi bi-list"></i></button>
    <nav class="sidebar" id="sidebar"></nav>
    <main><div id="app-content"></div></main>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  <script>
    function toggleSidebar(){
      document.getElementById('sidebar').classList.toggle('open');
      document.getElementById('sidebarOverlay').classList.toggle('active');
    }
    document.addEventListener('click',function(e){
      if(e.target.closest('.sidebar-overlay.active')) toggleSidebar();
    });
    function getToken(){return localStorage.getItem('token')}
    function authHeaders(){const t=getToken();return t?{'Authorization':'Bearer '+t}:{}}
    async function handleRes(r){if(r.status===401){localStorage.removeItem('token');showLogin();throw{error:'Sesi\u00f3n expirada'}}return r}
    const API = {
      async get(u){const r=await handleRes(await fetch(u,{headers:authHeaders()}));if(!r.ok)throw await r.json();return r.json()},
      async post(u,b){const r=await handleRes(await fetch(u,{method:'POST',headers:{...authHeaders(),'Content-Type':'application/json'},body:JSON.stringify(b)}));if(!r.ok)throw await r.json();return r.json()},
      async put(u,b){const r=await handleRes(await fetch(u,{method:'PUT',headers:{...authHeaders(),'Content-Type':'application/json'},body:JSON.stringify(b)}));if(!r.ok)throw await r.json();return r.json()},
      async del(u){const r=await handleRes(await fetch(u,{method:'DELETE',headers:authHeaders()}));if(!r.ok)throw await r.json();return r.json()}
    };
    const $ = id => document.getElementById(id);
    const esc = s => { const d=document.createElement('div'); d.textContent=s??''; return d.innerHTML; };
    const fmt = (v,d) => v!=null&&v!=='' ? (d?Number(v).toFixed(d):v) : '';
    const money = v => v!=null ? `$${Number(v).toLocaleString('es',{minimumFractionDigits:2,maximumFractionDigits:2})}` : '';

    const MODULES = {
      dashboard: { icon:'speedometer2', label:'Dashboard' },
      comprobantes: { icon:'file-text', label:'Comprobantes' },
      clientes: { icon:'people', label:'Clientes' },
      proveedores: { icon:'truck', label:'Proveedores' },
      stock: { icon:'box', label:'Stock / Productos' },
      pedidos: { icon:'cart', label:'Pedidos' },
      movmercaderia: { icon:'arrow-left-right', label:'Mov. Mercadería' },
      movcaja: { icon:'cash', label:'Mov. Caja' },
      cobranzas: { icon:'receipt', label:'Recibos / Cta.Cte.' },
      ventas: { icon:'cart-check', label:'Ventas' },
      compras_tesoreria: { icon:'wallet', label:'Compras / Tesorería' },
      maestros: { icon:'bookmark-star', label:'Maestros' },
      ctacte: { icon:'wallet2', label:'Cta.Cte.' },

      rrhh: { icon:'person-badge', label:'RRHH / Sueldos' },
      tesoreria: { icon:'piggy-bank', label:'Tesorería' },
      contabilidad: { icon:'journal', label:'Contabilidad' },
      impuestos: { icon:'file-earmark-text', label:'Impuestos' },
      obras: { icon:'building', label:'Obras / Licitaciones' },
      usuarios: { icon:'person-lock', label:'Usuarios' },
    };
    let currentUser = null;
    try { currentUser = JSON.parse(localStorage.getItem('user')||'{}'); } catch(e){}

    const GROUPS = [
      { label:'Principales', items:['dashboard','comprobantes','clientes','proveedores','stock','pedidos','ventas'] },
      { label:'Movimientos', items:['movmercaderia','movcaja'] },
      { label:'Administración', items:['tesoreria','contabilidad','impuestos','cobranzas','ctacte','compras_tesoreria','obras'] },
      { label:'RRHH', items:['rrhh'] },
      { label:'Sistema', items:['usuarios'] },
    ];

    let currentModule = 'dashboard', currentData = [];
    let moduleCache = {};

    function buildSidebar() {
      const u=currentUser;
      let html = `<div class="brand"><h6><i class="bi bi-database me-2"></i>ERP FYPC</h6><small>${u.nombre||u.username||''}</small></div>`;
      GROUPS.forEach(g => {
        html += `<div class="mod-group">${g.label}</div>`;
        g.items.forEach(m => {
          const mod = MODULES[m];
          if (!mod) return;
          html += `<a class="nav-link" href="#" data-module="${m}"><i class="bi bi-${mod.icon}"></i>${mod.label}</a>`;
        });
      });
      html += `<div style="padding:10px 16px;border-top:1px solid #1f2d3d;margin-top:auto">
        <a href="#" onclick="doLogout()" class="nav-link" style="display:flex;align-items:center;gap:8px;color:#8899aa">
          <i class="bi bi-box-arrow-right"></i>Cerrar sesi\u00f3n</a></div>`;
      $('sidebar').innerHTML = html;
      document.querySelectorAll('.sidebar .nav-link').forEach(a => {
        a.addEventListener('click', e => {
          e.preventDefault();
          document.getElementById('sidebar').classList.remove('open');
          document.getElementById('sidebarOverlay').classList.remove('active');
          loadModule(a.dataset.module);
        });
      });
    }

    function renderLoading() { return '<div class="loading"><div class="spinner-border text-primary" role="status"></div><p class="mt-2 text-muted">Cargando...</p></div>'; }

    let sortGlob = { col: '', dir: 'asc', fn: null };

    function buildSortableTable(cols, data) {
      if (!data||!data.length) return '<div class="alert alert-info m-3">Sin resultados</div>';
      let h = '<div class="table-wrap"><table class="table table-sm table-hover mb-0"><thead><tr>';
      cols.forEach(c => {
        const active = sortGlob.col === c.key;
        h += `<th style="cursor:pointer" onclick="sortCob('${c.key}')">${c.label} ${active ? (sortGlob.dir==='asc'?'▲':'▼') : '⇅'}</th>`;
      });
      h += '</tr></thead><tbody>';
      let sorted = [...data];
      if (sortGlob.col) {
        const k = sortGlob.col, d = sortGlob.dir;
        sorted.sort((a,b) => {
          let va = a[k], vb = b[k];
          if (va == null) va = ''; if (vb == null) vb = '';
          if (typeof va === 'number') return d==='asc' ? va-vb : vb-va;
          return d==='asc' ? String(va).localeCompare(String(vb)) : String(vb).localeCompare(String(va));
        });
      }
      sorted.forEach((r,i) => {
        h += '<tr>';
        cols.forEach(c => {
          let v = c.render ? c.render(r[c.key]) : esc(r[c.key]);
          h += `<td>${v}</td>`;
        });
        h += '</tr>';
      });
      h += '</tbody></table></div>';
      if (data.length >= 500) h += '<p class="text-muted small px-3 pb-2">Mostrando hasta 500 registros</p>';
      return h;
    }

    window.sortCob = (col) => {
      if (sortGlob.col === col) sortGlob.dir = sortGlob.dir === 'asc' ? 'desc' : 'asc';
      else { sortGlob.col = col; sortGlob.dir = 'asc'; }
      loadCobTab();
    };

    function buildTable(cols, data, rowKey) {
      if (!data||!data.length) return '<div class="alert alert-info m-3">Sin resultados</div>';
      let h = '<div class="table-wrap"><table class="table table-sm table-hover mb-0"><thead><tr>';
      cols.forEach(c => { h+=`<th>${c.label}</th>`; });
      h+='</tr></thead><tbody>';
      data.forEach((r,i) => {
        const key = rowKey ? r[rowKey] : i;
        h+=`<tr class="row-click" onclick="showDetail('${key}')">`;
        cols.forEach(c => {
          let v = c.render ? c.render(r[c.key]) : esc(r[c.key]);
          h+=`<td>${v}</td>`;
        });
        h+='</tr>';
      });
      h+='</tbody></table></div>';
      if(data.length>=500) h+='<p class="text-muted small px-3 pb-2">Mostrando hasta 500 registros</p>';
      return h;
    }

    function buildSearchInput(placeholder) {
      return `<div class="row g-2 mb-3 align-items-center">
        <div class="col-md-5">
          <div class="input-group input-group-sm search-box">
            <input type="text" class="form-control" id="s" placeholder="${placeholder}">
            <button class="btn btn-primary" onclick="doSearch()"><i class="bi bi-search"></i></button>
            <button class="btn btn-outline-secondary" onclick="clearSearch()"><i class="bi bi-x-lg"></i></button>
          </div>
        </div>
        <div class="col-md-2"><input type="date" class="form-control form-control-sm" id="fd"></div>
        <div class="col-md-2"><input type="date" class="form-control form-control-sm" id="fh"></div>
        <div class="col-md-1"><select class="form-select form-select-sm" id="lim"><option value="100">100</option><option value="500" selected>500</option><option value="1000">1000</option></select></div>
      </div>
      <div id="r"></div><div id="d"></div>`;
    }

    function sp() {
      const p=new URLSearchParams();
      const s=$('s')?.value; if(s) p.set('search',s);
      const fd=$('fd')?.value; if(fd) p.set('desde',fd);
      const fh=$('fh')?.value; if(fh) p.set('hasta',fh);
      p.set('limit',$('lim')?.value||'500');
      return p.toString();
    }

    function doSearch() { loadModule(currentModule); }
    function clearSearch() { ['s','fd','fh'].forEach(id=>{const e=$(id);if(e)e.value='';}); doSearch(); }

    function showDetail(id) {
      const fn = DETAIL_FUNCS[currentModule];
      if (fn) fn(id);
    }

    function renderSimple(endpoint, cols, rowKey, title, placeholder) {
      $('app-content').innerHTML = `<div class="module-header"><h4><i class="bi bi-${MODULES[currentModule]?.icon||'table'}"></i>${title}</h4></div>${buildSearchInput(placeholder||'Buscar...')}<div id="r"></div>`;
      const r=$('r'); r.innerHTML=renderLoading();
      API.get(`/api/${endpoint}?${sp()}`).then(d=>{currentData=d;r.innerHTML=buildTable(cols,d,rowKey);}).catch(e=>{r.innerHTML=`<div class="alert alert-danger">${e.error||e.message}</div>`;});
    }

    function loadModule(mod) {
      currentModule = mod;
      document.querySelectorAll('.sidebar .nav-link').forEach(l=>l.classList.remove('active'));
      document.querySelector(`.nav-link[data-module="${mod}"]`)?.classList.add('active');
      const fn = MODULE_FUNCS[mod];
      if (fn) fn();
      else $('app-content').innerHTML = '<div class="alert alert-warning">Módulo no implementado</div>';
    }

    function renderTabs(tabs, defaultTab, contentFn) {
      let h = `<ul class="nav nav-tabs mb-3" id="tabs">`;
      tabs.forEach((t,i) => { h+=`<li class="nav-item"><a class="nav-link ${i===0?'active':''}" href="#" data-tab="${t.id}">${t.label}</a></li>`; });
      h+=`</ul><div id="tabc"></div>`;
      $('app-content').innerHTML = h;
      contentFn(tabs[0].id);
      document.querySelectorAll('#tabs .nav-link').forEach(a => {
        a.addEventListener('click', e => {
          e.preventDefault();
          document.querySelectorAll('#tabs .nav-link').forEach(l=>l.classList.remove('active'));
          a.classList.add('active');
          contentFn(a.dataset.tab);
        });
      });
    }

    async function tabContent(endpointMap, tabId, title) {
      const c = $('tabc');
      c.innerHTML = renderLoading();
      const ep = endpointMap[tabId];
      if (!ep) { c.innerHTML='<div class="alert alert-info">Seleccione una pestaña</div>'; return; }
      try {
        const d = await API.get(`/api/${ep}?limit=300`);
        c.innerHTML = `<div class="card"><div class="card-header">${title||'Datos'}</div><div class="card-body p-0">${buildTable(epCols(ep)||[{key:'id',label:'ID'}],d)}</div></div>`;
      } catch(e) { c.innerHTML=`<div class="alert alert-danger">${e.error||e.message}</div>`; }
    }

